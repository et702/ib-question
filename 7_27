public Event mostPopularEvent() {
    Event mostPopular = events[0];

    for (int i = 1; i < numberofEvents; i++) {
        if (events[i].getTicketsSold() > mostPopular.getTicketsSold()) {
            mostPopular = events[i];
        }
    }
    return mostPopular;
}


