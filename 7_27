public void displayStudentAssignments()
{
    for (int i = 0; i < numberOfStudents; i++)
    {
        Student student = allStudents[i];
        String assignedActivity = student.getAssignedActivity();
        if (!assignedActivity.equals("NONE"))
        {
            System.out.println("Student " + student.getStudentName() + " is assigned to activity: " + assignedActivity);
        }
        else
        {
            System.out.println("Student " + student.getStudentName() + " is not assigned to any activity.");
        }
    }
}

